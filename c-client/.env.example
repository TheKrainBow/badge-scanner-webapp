# Copy to .env (same directory as the badge-lookup binary, or pass a path
# as the first argument) and fill in real values.

# Backend base URL (no trailing slash).
API_BASE=http://localhost:8080

# A "lookup"-scope API key, created from the webapp's Admin page (API Keys
# section) — NOT the webapp frontend's own "full"-scope key. A "lookup" key
# can only ever reach POST /api/lookup: no TIG, no coalition points, no
# blame, by construction on the backend side.
API_CLIENT_ID=change-me
API_CLIENT_SECRET=change-me
