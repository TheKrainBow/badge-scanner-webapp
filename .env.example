# Copy to .env (same directory as docker-compose.yml) and fill in real values.

# Optional — leave blank unless you want a "full"-scope API key
# pre-provisioned at first boot for some external automation client. The
# dashboard itself needs neither this nor any API key: session login is its
# whole auth layer (see README.md's auth-model section). Keys for actual
# external clients (e.g. the C badge-lookup client's "lookup"-scope key)
# are created from the dashboard's Admin page, not via env vars.
BOOTSTRAP_API_KEY_ID=
BOOTSTRAP_API_KEY_SECRET=

# Signs session cookies. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me

# Bootstraps the one hardcoded admin on first run only (ignored once any
# user account exists). Create additional accounts from the Admin page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# The compose setup serves everything over plain HTTP by default (put a
# reverse proxy with TLS in front for anything beyond local/LAN use); leave
# this as-is unless you've done that.
COOKIE_SECURE=false

# Host port the webapp is published on.
FRONTEND_PORT=8000
